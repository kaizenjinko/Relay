# relay.env — credentials for relay.service
#
# Install to /etc/relay/relay.env with mode 0600, owner relay:relay.
# systemd reads this file before starting the relay; nothing here is visible
# through `systemctl show` or `ps`.
#
#   sudo install -m 0600 -o relay -g relay relay.env.example /etc/relay/relay.env
#
# Every value is read by a [route.headers.dynamic.*] block with kind = "env".
# A credential that must rotate without a restart belongs in a cookie_jar file
# instead (see relay.toml.example).

# CNB session cookie. Two values, joined exactly as the browser sends them.
CNB_COOKIE="CNBSESSION=...; csrfkey=..."

# CNB CSRF token, sent as the Csrftoken header.
CNB_CSRF="..."

# Any OpenAI-compatible provider key, if a route references it.
# DEEPSEEK_KEY="sk-..."
